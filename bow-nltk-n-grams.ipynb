# 2.5 N-GRAMS
from nltk import ngrams

sentence = "this movie was not good at all"
print("Unigrams:", list(ngrams(sentence.split(), 1)))   # N = 1, single words
print("Bigrams :", list(ngrams(sentence.split(), 2)))
print("Trigrams:", list(ngrams(sentence.split(), 3)))

# In scikit-learn: unigrams AND bigrams
# (the default, ngram_range=(1, 1), means unigrams only; (1, 3) would add trigrams)
vec_ng = CountVectorizer(ngram_range=(1, 2))
X_ng = vec_ng.fit_transform(["this movie was good", "this movie was not good"])
print("\nFeatures:", list(vec_ng.get_feature_names_out()))
print("Vocabulary grew from",
      len(CountVectorizer().fit(["this movie was good", "this movie was not good"]).vocabulary_),
      "to", len(vec_ng.vocabulary_))

