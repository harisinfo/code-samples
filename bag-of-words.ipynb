# 2.4 BAG OF WORDS
from sklearn.feature_extraction.text import CountVectorizer

docs = [
    "The product arrived quickly and works well",
    "Terrible product, arrived late and broken",
    "Quick delivery, great product, works great",
    "Late delivery and poor service",
]

# By hand with Counter: one dictionary per document
for d in docs[:2]:
    print(Counter(preprocess_nltk(d)))

# With scikit-learn (default ngram_range=(1, 1): unigrams only, one column per single word)
vec = CountVectorizer(stop_words="english")
X = vec.fit_transform(docs)                 # sparse matrix: documents x vocabulary

print("\nVocabulary:", vec.get_feature_names_out())
print("Matrix shape:", X.shape)

bow = pd.DataFrame(X.toarray(), columns=vec.get_feature_names_out(),
                   index=[f"doc{i}" for i in range(len(docs))])
bow
