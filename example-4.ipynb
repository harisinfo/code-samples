from nltk.corpus import stopwords

text = "The Quick brown fox, 3 times, jumped OVER the lazy dog... and wasn't tired!"

tokens = word_tokenize(text.lower())
print("Tokens   :", tokens)

alpha_tokens = [t for t in tokens if t.isalpha()]
print("Alphabetic:", alpha_tokens)


nltk_stops = set(stopwords.words("english"))
print("\nNLTK list size :", len(nltk_stops))
print("Sample         :", sorted(nltk_stops)[:12])
filtered = [t for t in alpha_tokens if t not in nltk_stops]
print("After removal  :", filtered)


spacy_stops = nlp.Defaults.stop_words
print("\nspaCy list size:", len(spacy_stops))
print("In spaCy but not NLTK (sample):", sorted(spacy_stops - nltk_stops)[:12])

alice = gutenberg.words("carroll-alice.txt")
alice = [w.lower() for w in alice if w.isalpha()]
print("\nTop 8 raw     :", Counter(alice).most_common(8))
print("Top 8 filtered:", Counter(w for w in alice if w not in nltk_stops).most_common(8))

print("\n'not' is a stopword:", "not" in nltk_stops)
