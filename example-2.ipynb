tricky = "State-of-the-art NLP costs £1,000.50 :) Email me@example.com, it's 5pm in New York!"

print("split()        :", tricky.split())
print("regex \\w+      :", re.findall(r"\w+", tricky))
print("NLTK word_tok  :", word_tokenize(tricky))
print("TweetTokenizer :", TweetTokenizer().tokenize(tricky))
print("spaCy          :", [t.text for t in nlp(tricky)])

counts = {
    "split": len(tricky.split()),
    "regex": len(re.findall(r"\w+", tricky)),
    "NLTK": len(word_tokenize(tricky)),
    "Tweet": len(TweetTokenizer().tokenize(tricky)),
    "spaCy": len(nlp(tricky)),
}
print("\nToken counts:", counts)
# Same sentence, different counts. Decide which one suits your task.
