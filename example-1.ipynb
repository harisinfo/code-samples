from nltk.tokenize import word_tokenize, sent_tokenize, TweetTokenizer

text = "Dr. Smith didn't visit London on 5 Nov. He's coming back next week! Isn't that great?"

# "State-of-the-art NLP costs £1,000.50 :) Email me@example.com, it's 5pm in New York!"

# 1. Plain Python
print("split()      :", text.split())
print("regex \\w+    :", re.findall(r"\w+", text))
print("regex better :", re.findall(r"\w+(?:'\w+)?", text))


print("NLTK words   :", word_tokenize(text))

print("NLTK sents   :", sent_tokenize(text)) 

tweet = "#NLP is great @bmc :) this is fantastic!!!"
print("Tweet default:", word_tokenize(tweet))
print("TweetTokenizer:", TweetTokenizer().tokenize(tweet))

doc = nlp(text)
print("spaCy tokens :", [t.text for t in doc])
print("spaCy sents  :", [s.text for s in doc.sents])
